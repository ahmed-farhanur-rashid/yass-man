# ── SearXNG ───────────────────────────────────────────────────────────────────
# Point at a public instance or self-hosted. Find API-enabled public instances at:
# https://searx.space (look for the ✓ API column)
SEARXNG_URL=https://searx.example.org

# ── Paths ─────────────────────────────────────────────────────────────────────
MODEL_DIR=./models
LOG_DIR=./data/logs
MODEL_CONFIG_PATH=./model_config.yaml

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_LLM=true
ENABLE_CLUSTERING=true
ENABLE_FEEDBACK=true

# ── Pipeline ──────────────────────────────────────────────────────────────────
TOP_K_RESULTS=10
MAX_EXPANDED_QUERIES=5
SEARCH_TIMEOUT_SECONDS=2

# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
RELOAD=false
